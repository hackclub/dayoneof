# dev = local tunnel + test Airtable/Slack, prod = the deployed site. Defaults to dev when unset.
APP_ENV=dev

# Every var below may be suffixed _DEV or _PROD. The suffixed value wins when it matches APP_ENV;
# the unsuffixed name is the shared fallback for anything that's the same in both.

PUBLIC_SITE_URL_DEV=
PUBLIC_SITE_URL_PROD=

AIRTABLE_TOKEN=
AIRTABLE_BASE_ID_DEV=
AIRTABLE_BASE_ID_PROD=

SLACK_BOT_TOKEN_DEV=xoxb-...
SLACK_BOT_TOKEN_PROD=xoxb-...
SLACK_SIGNING_SECRET_DEV=
SLACK_SIGNING_SECRET_PROD=
SLACK_SUBMISSION_CHANNEL_ID_DEV=
SLACK_SUBMISSION_CHANNEL_ID_PROD=
SLACK_ANNOUNCE_CHANNEL_ID_DEV=
SLACK_ANNOUNCE_CHANNEL_ID_PROD=

HCA_CLIENT_ID_DEV=
HCA_CLIENT_SECRET_DEV=
HCA_CLIENT_ID_PROD=
HCA_CLIENT_SECRET_PROD=

# Per-environment on purpose: a shared SESSION_SECRET means a cookie signed locally is valid on
# prod, and a shared CRON_SECRET means the copy on your laptop can fire prod's nightly jobs.
SESSION_SECRET_DEV=
SESSION_SECRET_PROD=
CRON_SECRET_DEV=
CRON_SECRET_PROD=

UNIFIED_SOCIALS_TOKEN=
UNIFIED_SOCIALS_API_URL=
MIN_REVIEW_LENGTH=40
ADMIN_SLACK_IDS=
